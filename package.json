{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.3.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucas-barake/effect-monorepo.git"
  },
  "scripts": {
    "codegen": "pnpm --recursive --parallel run codegen",
    "build": "node node_modules/typescript/bin/tsc -b tsconfig.build.json && pnpm --recursive --parallel run build",
    "check": "node node_modules/typescript/bin/tsc -b tsconfig.json && pnpm -F @org/components check && pnpm -F @org/web check",
    "check:recursive": "pnpm --recursive exec node ../../node_modules/typescript/bin/tsc -b tsconfig.json",
    "check:effect": "node scripts/check-effect-diagnostics.mjs",
    "check:all": "pnpm lint && pnpm lint:rules && pnpm lint:edges && pnpm lint:architecture && pnpm check && pnpm check:effect && pnpm test && pnpm smoke:bins && pnpm -F @org/components build-storybook",
    "lint": "oxlint --type-aware --deny-warnings packages && pnpm lint:svelte",
    "lint:svelte": "eslint --max-warnings 0 \"packages/**/*.svelte\"",
    "lint:fix": "oxlint --type-aware packages --fix",
    "lint:rules": "node scripts/lint-rule-probes.mjs",
    "graph": "node scripts/service-graph.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "TEST_INTEGRATION=true vitest run --project=@org/server && TEST_INTEGRATION=true vitest run --project=@org/jobs && TEST_INTEGRATION=true vitest run --project=@org/identity",
    "test:workers": "TEST_WORKERS=true ALCHEMY_DEV=true vitest run --project=@org/infra",
    "test:acceptance": "pnpm -F @org/acceptance test",
    "test:coverage:unit": "vitest run --coverage --reporter=blob --outputFile.blob=.vitest-reports/unit.json",
    "test:coverage:integration": "TEST_INTEGRATION=true vitest run packages/server/ --coverage --reporter=blob --outputFile.blob=.vitest-reports/integration-server.json && TEST_INTEGRATION=true vitest run packages/jobs/ --coverage --reporter=blob --outputFile.blob=.vitest-reports/integration-jobs.json && TEST_INTEGRATION=true vitest run packages/identity/ --coverage --reporter=blob --outputFile.blob=.vitest-reports/integration-identity.json",
    "coverage:merge": "vitest run --merge-reports=.vitest-reports --coverage",
    "coverage": "pnpm test:coverage:unit && pnpm test:coverage:integration && pnpm coverage:merge",
    "dev": "pnpm -F @org/contracts build && pnpm -F @org/infra run dev",
    "deploy:cf": "pnpm -F @org/infra exec alchemy deploy",
    "destroy:cf": "pnpm -F @org/infra exec alchemy destroy",
    "db:migrate": "pnpm db:migrate:app && pnpm db:migrate:identity",
    "db:migrate:app": "pnpm -F @org/database db:migrate",
    "db:migrate:identity": "pnpm -F @org/identity db:migrate",
    "seed:identity": "tsx scripts/seed-identity.mjs",
    "bootstrap": "node scripts/dev-bootstrap.mjs",
    "effect:source": "node scripts/sync-effect-source.mjs",
    "format": "prettier --write \"**/*.{js,ts,mjs,jsx,tsx,json,md,css,html,yaml,yml,mdx,svelte}\"",
    "format:check": "prettier --check \"**/*.{js,ts,mjs,jsx,tsx,json,md,css,html,yaml,yml,mdx,svelte}\"",
    "prepare": "husky && effect-tsgo patch --oxlint",
    "lint:edges": "node scripts/architecture-edges.mjs",
    "lint:architecture": "architecture check packages",
    "architecture:baseline": "architecture baseline packages",
    "architecture:explain": "architecture explain",
    "architecture:coverage": "architecture coverage packages",
    "architecture:conformance": "architecture conformance packages",
    "architecture:campaigns": "architecture campaigns packages",
    "architecture:facts": "architecture facts",
    "architecture:browser": "goodbones-browser",
    "smoke:bins": "pnpm -F @org/cli bundle && pnpm -F @org/mcp bundle && node scripts/smoke-bins.mjs"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@effect/build-utils": "0.8.9",
    "@effect/language-service": "0.87.4",
    "@effect/tsgo": "0.53.0",
    "@effect/vitest": "4.0.2",
    "@goodbones/ast-grep": "0.1.3-beta.6",
    "@goodbones/browser": "0.1.0-beta.9",
    "@goodbones/campaigns": "0.1.1-beta.8",
    "@goodbones/cli": "0.1.0-beta.20",
    "@goodbones/core": "0.1.0-beta.17",
    "@goodbones/oxlint": "0.1.0-beta.20",
    "@goodbones/typescript": "0.1.0-beta.18",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^25.9.4",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "babel-plugin-annotate-pure-calls": "^0.4.0",
    "effect": "4.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-codegen": "^0.34.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-storybook": "^10.4.6",
    "eslint-plugin-svelte": "^3.23.1",
    "glob": "^11.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxlint": "1.88.0",
    "oxlint-plugin-effect": "0.28.1",
    "oxlint-tsgolint": "7.0.2004",
    "pg": "^8.20.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "read-package-up": "^12.0.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "vitest": "^5.0.3",
      "vite": "^8.3.4",
      "effect": "4.0.2",
      "@goodbones/browser>effect": "4.0.0-beta.94",
      "@goodbones/campaigns>effect": "4.0.0-beta.94",
      "@goodbones/cli>effect": "4.0.0-beta.94",
      "@goodbones/core>effect": "4.0.0-beta.94",
      "@goodbones/oxlint>effect": "4.0.0-beta.94",
      "@goodbones/typescript>effect": "4.0.0-beta.94",
      "@effect/platform-node": "4.0.2",
      "@effect/build-utils": "0.8.9",
      "@effect/language-service": "0.87.4",
      "@effect/vitest": "4.0.2",
      "@opentelemetry/resources": "2.7.1",
      "@opentelemetry/sdk-trace-web": "2.7.1",
      "protobufjs": "^7.5.5",
      "form-data": "^4.0.4",
      "flatted": "^3.4.2",
      "rollup": "^4.60.0",
      "lodash": "^4.18.1",
      "glob@10": "^10.5.0",
      "glob@11": "^11.1.0",
      "uuid": "^14.0.0",
      "js-yaml@3": "^3.14.2",
      "@babel/runtime": "^7.26.10",
      "esbuild": "^0.25.0",
      "picomatch@4": "^4.0.4",
      "minimatch@9": "^9.0.7",
      "@effect/platform-node-shared": "4.0.2",
      "@effect/sql-pg": "4.0.2"
    },
    "patchedDependencies": {
      "babel-plugin-annotate-pure-calls@0.4.0": "patches/babel-plugin-annotate-pure-calls@0.4.0.patch"
    }
  }
}
