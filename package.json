{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": "22.13.1",
    "pnpm": "10.3.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucas-barake/effect-monorepo.git"
  },
  "scripts": {
    "codegen": "pnpm --recursive --parallel run codegen",
    "build": "node node_modules/typescript/bin/tsc -b tsconfig.build.json && pnpm --recursive --parallel run build",
    "check": "node node_modules/typescript/bin/tsc -b tsconfig.json",
    "check:recursive": "pnpm --recursive exec node ../../node_modules/typescript/bin/tsc -b tsconfig.json",
    "check:effect": "node scripts/check-effect-diagnostics.mjs",
    "check:all": "pnpm lint && pnpm lint:rules && pnpm lint:deps && pnpm check && pnpm check:effect && pnpm test && pnpm -F @org/components build-storybook",
    "lint": "oxlint --type-aware --quiet packages",
    "lint:fix": "oxlint --type-aware packages --fix",
    "lint:rules": "node scripts/lint-rule-probes.mjs",
    "graph": "node scripts/service-graph.mjs",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs packages/server/src packages/contracts/src packages/jobs/src && depcruise --config .dependency-cruiser.cjs --ts-config tsconfig.depcruise-web.json packages/web packages/components",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "TEST_INTEGRATION=true pnpm --workspace-concurrency=1 --filter @org/server --filter @org/jobs run test --run",
    "test:acceptance": "pnpm -F @org/acceptance test",
    "dev": "pnpm --parallel --filter @org/server --filter @org/web run dev",
    "bootstrap": "node scripts/dev-bootstrap.mjs",
    "effect:source": "node scripts/sync-effect-source.mjs",
    "auth:up": "docker compose up -d zitadel",
    "auth:seed": "docker compose --profile seed-zitadel up --abort-on-container-exit seed-zitadel",
    "auth:down": "docker compose stop zitadel",
    "auth:logs": "docker compose logs -f zitadel",
    "auth:reset": "node scripts/auth-reset.mjs",
    "jobs:dev": "pnpm -F @org/jobs dev",
    "format": "prettier --write \"**/*.{js,ts,mjs,jsx,tsx,json,md,css,html,yaml,yml,mdx}\"",
    "format:check": "prettier --check \"**/*.{js,ts,mjs,jsx,tsx,json,md,css,html,yaml,yml,mdx}\"",
    "coverage": "vitest --coverage",
    "prepare": "husky && effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@effect/build-utils": "0.8.9",
    "@effect/language-service": "0.85.1",
    "@effect/tsgo": "^0.36.1",
    "@effect/vitest": "4.0.0-beta.94",
    "@synapsestudios/eslint-plugin-data-boundaries": "^2.0.4",
    "@types/node": "^25.9.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-annotate-pure-calls": "^0.4.0",
    "dependency-cruiser": "^17.4.3",
    "effect": "4.0.0-beta.94",
    "eslint-plugin-codegen": "^0.34.1",
    "eslint-plugin-project-structure": "file:vendor/eslint-plugin-project-structure-3.14.3-perf.tgz",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-storybook": "^10.4.6",
    "glob": "^11.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "read-package-up": "^12.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "vitest": "^3.2.0",
      "effect": "4.0.0-beta.94",
      "@effect/platform-node": "4.0.0-beta.94",
      "@effect/build-utils": "0.8.9",
      "@effect/language-service": "0.85.1",
      "@effect/vitest": "4.0.0-beta.94",
      "@opentelemetry/resources": "2.7.1",
      "@opentelemetry/sdk-trace-web": "2.7.1",
      "protobufjs": "^7.5.5",
      "form-data": "^4.0.4",
      "flatted": "^3.4.2",
      "rollup": "^4.60.0",
      "lodash": "^4.18.1",
      "glob@10": "^10.5.0",
      "glob@11": "^11.1.0",
      "uuid": "^14.0.0",
      "js-yaml@3": "^3.14.2",
      "@babel/runtime": "^7.26.10",
      "esbuild": "^0.25.0",
      "picomatch@4": "^4.0.4",
      "minimatch@9": "^9.0.7"
    },
    "patchedDependencies": {
      "babel-plugin-annotate-pure-calls@0.4.0": "patches/babel-plugin-annotate-pure-calls@0.4.0.patch"
    }
  }
}
