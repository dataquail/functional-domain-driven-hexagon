{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "types": ["$app/types", "svelte", "vite/client", "@cloudflare/workers-types"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "@org/contracts": ["../contracts/build/esm/index.js"],
      "@org/contracts/*": ["../contracts/build/dts/*", "../contracts/build/esm/*"]
    }
  },
  "include": ["**/*.ts", "**/*.svelte"],
  "exclude": ["node_modules", "src/service-worker", ".svelte-kit/output"]
}
