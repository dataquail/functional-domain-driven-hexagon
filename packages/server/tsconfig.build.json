{
  "extends": "./tsconfig.src.json",
  // Must list every workspace package `src/` imports. This overrides (not extends)
  // tsconfig.src.json's references, so a package missing here resolves through the
  // inherited `paths` with no declarations behind it and degrades to `any`.
  "references": [
    { "path": "../contracts/tsconfig.build.json" },
    { "path": "../database/tsconfig.build.json" },
    { "path": "../jobs/tsconfig.build.json" },
    { "path": "../module/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": false,
    "types": ["node"],
    "tsBuildInfoFile": ".tsbuildinfo/build.tsbuildinfo",
    "outDir": "build/esm",
    "declarationDir": "build/dts",
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
