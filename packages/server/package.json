{
  "name": "@org/server",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "The server template",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucas-barake/effect-monorepo.git",
    "directory": "packages/server"
  },
  "scripts": {
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "clean": "rm -rf build .tsbuildinfo",
    "prebuild": "npm run clean",
    "build": "tsc -b tsconfig.build.json",
    "circular": "madge --circular src/platform/worker/main.ts",
    "lint": "eslint . --quiet",
    "format": "prettier --write .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@effect-server-utils/authz": "0.1.0-beta.5",
    "@effect-server-utils/cqrs": "0.1.0-beta.9",
    "@effect-server-utils/unit-of-work": "0.1.0-beta.9",
    "@org/contracts": "workspace:^",
    "@org/database": "workspace:^",
    "@org/jobs": "workspace:^",
    "cookie": "^1.1.1",
    "effect": "4.0.2",
    "openid-client": "^6.8.4",
    "stripe": "^22.3.0",
    "svix": "^1.96.1"
  },
  "effect": {
    "generateExports": {
      "include": [
        "**/*.ts"
      ]
    },
    "generateIndex": {
      "include": [
        "**/*.ts"
      ]
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@effect/platform-node": "4.0.2",
    "@effect/sql-pg": "4.0.2",
    "@types/cookie": "^0.6.0",
    "madge": "^8.0.0"
  }
}
