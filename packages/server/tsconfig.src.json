{
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "exclude": ["vitest.config.ts", "src/**/*.test.ts"],
  "references": [
    { "path": "../authz" },
    { "path": "../contracts" },
    { "path": "../cqrs" },
    { "path": "../database" }
  ],
  "compilerOptions": {
    "types": ["node"],
    // React Email templates (`infrastructure/external/*.tsx`) are authored as
    // JSX and compiled with the automatic runtime — `react` is a dependency.
    "jsx": "react-jsx",
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "rootDir": "src",

    "paths": {
      "@/*": ["./src/*"],
      "@org/authz": ["../authz/src/index.js"],
      "@org/authz/*": ["../authz/src/*.js"],
      "@org/contracts": ["../contracts/src/index.js"],
      "@org/contracts/*": ["../contracts/src/*.js"],
      "@org/cqrs": ["../cqrs/src/index.js"],
      "@org/cqrs/*": ["../cqrs/src/*.js"],
      "@org/database": ["../database/src/index.js"],
      "@org/database/*": ["../database/src/*.js"]
    }
  }
}
