{
  "name": "@org/test-drivers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Tier-agnostic page driver contracts + per-tier adapters (Playwright for acceptance, Svelte Testing Library for integration). The contract is expressed in business intent (createUser, expectUserInList) so the same spec body runs at multiple tiers.",
  "exports": {
    "./contracts/*": "./src/contracts/*.ts",
    "./adapters/playwright/*": "./src/adapters/playwright/*.ts",
    "./adapters/svelte-tl/*": "./src/adapters/svelte-tl/*.ts"
  },
  "scripts": {
    "check": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --quiet"
  },
  "peerDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/svelte": "^5.4.2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    },
    "@testing-library/svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.4",
    "svelte": "^5.57.2",
    "typescript": "^6.0.3"
  }
}
