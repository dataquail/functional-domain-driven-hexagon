{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./.oxlintrc.base.json"],
  // `extends` merges rules and plugins but not ignorePatterns; the base carries the
  // same list for the campaign report, which runs it without the architecture plugin.
  "ignorePatterns": [
    "**/dist",
    "**/build",
    "**/docs",
    "**/*.md",
    "**/vitest.config.ts",
    "**/setupTests.ts",
    "**/vitest.shared.ts",
    "reference/**",
    "scratchpad/**",
    "**/.tmp-*/**",
    "**/routeTree.gen.ts",
    "**/.next/**",
    "**/postcss.config.mjs"
  ],
  "jsPlugins": [
    {
      "name": "architecture",
      "specifier": "@goodbones/oxlint/plugin"
    }
  ],
  "rules": {
    "architecture/imports": "error",
    "architecture/exports": "error",
    "architecture/members": "error",
    "architecture/structure": "error",
    "architecture/surface": "error",
    "architecture/campaigns": "error"
  }
}
