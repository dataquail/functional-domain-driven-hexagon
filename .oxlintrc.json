{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "plugins": ["typescript", "import"],
  "jsPlugins": [
    {
      "name": "local",
      "specifier": "./scripts/lint-rules/index.mjs"
    },
    {
      "name": "architecture",
      "specifier": "@goodbones/oxlint/plugin"
    },
    "eslint-plugin-codegen",
    "eslint-plugin-simple-import-sort",
    "eslint-plugin-sort-destructure-keys",
    "eslint-plugin-storybook"
  ],
  "categories": {
    "correctness": "off"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "es2018": true
  },
  "ignorePatterns": [
    "**/dist",
    "**/build",
    "**/docs",
    "**/*.md",
    "**/vitest.config.ts",
    "**/setupTests.ts",
    "**/vitest.shared.ts",
    "reference/**",
    "scratchpad/**",
    "**/.tmp-*/**",
    "**/routeTree.gen.ts",
    "**/.svelte-kit/**",
    "**/postcss.config.mjs"
  ],
  "rules": {
    "architecture/imports": "error",
    "architecture/exports": "error",
    "architecture/members": "error",
    "architecture/structure": "error",
    "architecture/surface": "error",
    "architecture/campaigns": "error",
    "import/no-cycle": "error",
    "constructor-super": "error",
    "for-direction": "error",
    "getter-return": "error",
    "no-async-promise-executor": "error",
    "no-case-declarations": "error",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-const-assign": "error",
    "no-constant-binary-expression": "error",
    "no-constant-condition": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-delete-var": "error",
    "no-dupe-class-members": "error",
    "no-dupe-else-if": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty": "error",
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-empty-static-block": "error",
    "no-ex-assign": "error",
    "no-extra-boolean-cast": "error",
    "no-func-assign": "error",
    "no-global-assign": "error",
    "no-import-assign": "error",
    "no-invalid-regexp": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-new-native-nonconstructor": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-obj-calls": "error",
    "no-prototype-builtins": "error",
    "no-redeclare": "off",
    "no-regex-spaces": "error",
    "no-self-assign": "error",
    "no-setter-return": "error",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    "no-this-before-super": "error",
    "no-undef": "off",
    "no-unexpected-multiline": "error",
    "no-unreachable": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "vars": "all",
        "args": "all",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-useless-backreference": "error",
    "no-useless-catch": "error",
    "no-useless-escape": "error",
    "no-with": "error",
    "require-yield": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "no-unused-expressions": "error",
    "codegen/codegen": "error",
    "object-shorthand": "error",
    "no-console": "error",
    "local/no-relative-import-outside-package": "error",
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-duplicates": "error",
    "simple-import-sort/imports": "error",
    "simple-import-sort/exports": "error",
    "sort-destructure-keys/sort-destructure-keys": "error",
    "prefer-const": "error",
    "no-var": "error",
    "no-else-return": "error",
    "eqeqeq": "error",
    "no-lonely-if": "error",
    "no-unneeded-ternary": "error",
    "no-plusplus": [
      "error",
      {
        "allowForLoopAfterthoughts": true
      }
    ],
    "no-implicit-coercion": "error",
    "no-shadow": "warn",
    "no-self-compare": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/array-type": [
      "warn",
      {
        "default": "generic",
        "readonly": "generic"
      }
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/consistent-type-exports": [
      "error",
      {
        "fixMixedExportsWithInlineTypeSpecifier": true
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-empty-interface": "error",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "typescript/return-await": "error",
    "typescript/consistent-type-definitions": ["warn", "type"],
    "typescript/explicit-member-accessibility": [
      "error",
      {
        "accessibility": "explicit",
        "overrides": {
          "accessors": "off",
          "constructors": "no-public",
          "methods": "explicit",
          "properties": "explicit",
          "parameterProperties": "explicit"
        }
      }
    ],
    "typescript/consistent-generic-constructors": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowString": false,
        "allowNumber": false,
        "allowNullableObject": false,
        "allowNullableBoolean": false,
        "allowNullableString": false,
        "allowNullableNumber": false,
        "allowNullableEnum": false,
        "allowAny": false
      }
    ],
    "typescript/dot-notation": "error",
    // A generator's `return yield* error` is Effect's narrowing idiom — the value
    // travels the Effect channel, not the return — and TypeScript already knows an
    // exhaustive switch over a closed union returns on every path.
    "typescript/consistent-return": "off",
    // Effect v4's Random module carries no UUID; an id is minted from crypto inside
    // Effect.sync, which is the seam the rule asks for.
    "effecttsgo/crypto-random-uuid-in-effect": "off",
    "local/no-array-push-spread": "error",
    "no-use-before-define": "warn",
    "effecttsgo/prefer-schema-over-json": "off"
  },
  "overrides": [
    {
      "files": ["packages/server/**/*.{ts,tsx,js,jsx}", "packages/web-svelte/**/*.{ts,js}"],
      "rules": {
        "local/no-deep-relative-imports": "error"
      }
    },
    {
      "files": ["packages/server/src/modules/**/*.{ts,tsx}"],
      "rules": {
        "local/no-cross-schema-sql-access": "error"
      }
    },
    {
      "files": [".storybook/main.@(js|cjs|mjs|ts)"],
      "rules": {
        "storybook/no-uninstalled-addons": "error"
      }
    },
    {
      "files": [
        "packages/server/src/modules/**/*.command-handlers.ts",
        "packages/server/src/modules/**/*.query-handlers.ts",
        "packages/server/src/modules/**/queries/*.query.ts",
        "packages/server/src/modules/**/policies/*.policies.ts",
        "packages/server/src/modules/**/policies/*.resource-resolver*.ts",
        "packages/server/src/globals/infrastructure/auth/authz.ts"
      ],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      "files": ["packages/server/src/modules/**/*.{ts,tsx}"],
      "rules": {}
    },
    {
      // A test, a fixture harness, a Playwright driver or a story is the async
      // edge where an Effect is run, not where one is written: vitest, Playwright
      // and Storybook hand each callback a promise contract. The same files read
      // process.env because their runners set it before any Effect Config exists.
      "files": [
        "**/*.test.{ts,tsx}",
        "**/test/**/*.{ts,tsx}",
        "**/test-utils/**/*.{ts,tsx}",
        "packages/acceptance/**/*.ts",
        "packages/test-drivers/**/*.ts"
      ],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/process-env": "off",
        "effecttsgo/global-fetch": "off",
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      // SvelteKit owns these signatures: a hook and a load function are async, and
      // the server-side helpers they call are where the request's Effect runtime
      // is run.
      "files": ["packages/web-svelte/src/**/*.ts", "packages/web-svelte/services/**/*.server.ts"],
      "rules": {
        "effecttsgo/async-function": "off"
      }
    },
    {
      // A live client adapter is the seam over a promise SDK — openid-client, Stripe —
      // and the async closure inside its Effect.tryPromise is that seam, not control
      // flow that should have been an Effect.
      "files": [
        "**/infrastructure/clients/*.client.ts",
        "**/infrastructure/clients/*.client-live.ts"
      ],
      "rules": {
        "effecttsgo/async-function": "off"
      }
    },
    {
      // The CLI and MCP's environment boundary, read at call time by synchronous
      // error mappers that have no runtime to resolve a Config in.
      "files": ["packages/api-client/src/config.ts"],
      "rules": {
        "effecttsgo/process-env": "off"
      }
    },
    {
      // A Playwright spec is not Effect code; a unique fixture name needs a clock.
      "files": ["packages/acceptance/**/*.ts"],
      "rules": {
        "effecttsgo/global-date": "off"
      }
    },
    {
      // Storybook's config resolves its own paths with node's modules.
      "files": ["**/.storybook/**/*.ts"],
      "rules": {
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      // codegen parses the whole file as JavaScript and refuses a Svelte
      // component; oxlint itself lints only its script blocks.
      "files": ["**/*.svelte"],
      "rules": {
        "codegen/codegen": "off"
      }
    }
  ]
}
