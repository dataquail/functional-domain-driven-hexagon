{
  "plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
  "endOfLine": "auto",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "printWidth": 100,
  "tabWidth": 2,
  "tailwindStylesheet": "./packages/components-svelte/styles/globals.css"
}
