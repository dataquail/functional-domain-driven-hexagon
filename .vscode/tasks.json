{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Up",
      "detail": "Start postgres + jaeger + mailpit in the background",
      "type": "shell",
      "command": "docker compose up -d --wait postgres jaeger mailpit",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "close": true },
      "problemMatcher": []
    },
    {
      "label": "Docker: Down",
      "detail": "Stop all docker compose services (keeps the postgres volume)",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Docker: Migrate (dev DB)",
      "detail": "Apply migrations to effect-monorepo, then the identity database's",
      "type": "shell",
      "command": "pnpm db:migrate",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Docker: Migrate (test DB)",
      "detail": "Apply migrations to effect-monorepo-test",
      "type": "shell",
      "command": "pnpm --filter @org/database db:migrate:test",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Dev: Workers",
      "detail": "The whole stack under alchemy dev: web on :3000, server on :3001, identity on :3002",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Identity: Seed",
      "detail": "Register the app's OAuth client and the admin with the running identity Worker",
      "type": "shell",
      "command": "pnpm seed:identity",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Dev: All",
      "detail": "Docker → migrate → the Workers stack",
      "dependsOn": ["Docker: Up", "Docker: Migrate (dev DB)", "Dev: Workers"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
