{
  "compilerOptions": {
    "baseUrl": ".",
    // Extensionless targets, for the reason spelled out in tsconfig.resolve.json.
    // `$app/*` is SvelteKit's runtime, which Kit's plugin serves from these files.
    "paths": {
      "@/*": ["./packages/web/*"],
      "@org/contracts/*": ["./packages/contracts/src/*"],
      "@org/test-drivers/*": ["./packages/test-drivers/src/*"],
      "$app/*": ["./packages/web/node_modules/@sveltejs/kit/src/runtime/app/*"]
    },
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022"
  }
}
